    "escalation_window": 4,
    "over_route_token_threshold": 200,
    "over_route_session_token_cap": 1000,
    "undispatched_tool_threshold": 12,
    "escalation_nudge_threshold": 2,
    "repeat_read_nudge_threshold": 3,
    "undispatched_nudge_threshold": 1,
    "session_cadence_threshold": 15,
    "nudge_cooldown_hours": 2,
    "dispatch_budget_nudge_pct": 70.0,
    "pricing_per_1k": {
      "_comment": "MVP-1: these two flat output-only prices exist only for the 'estimated savings if re-routed to fast tier' display in analyze_routing.py's over-route report. They intentionally mirror scripts/pricing.json's sonnet/haiku output_per_1k so the two files don't drift silently apart — the real, per-model, input+output cost math for /cost-report lives in scripts/pricing.json via price_for(), not here. If you edit pricing.json's sonnet or haiku output_per_1k, update these two to match.",
      "reasoning_output": 0.015,
      "fast_output": 0.004
    },
    "repeat_dispatch_token_threshold": 500,
    "session_over_route_tool_call_cap": 5,
    "session_over_route_min_cost_usd": 0.005,
    "qa_full_file_read_threshold": 3,
    "qa_low_tool_call_threshold": 3
  }
