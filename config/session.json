    "max_counterfactual_log_bytes": 2097152
  },
  "runtime": {
    "target_hash_hex_chars": 12,
    "stdin_select_timeout_seconds": 0.5,
    "tail_read_chunk_bytes": 8192
  },
  "graph": {
    "ttl_days": 10
  },
  "impact": {
    "session_summary": true,
    "min_turns": 3,
    "min_savings_usd": 0.1,
    "cold_start_sessions": 3,
    "auto_weekly": true
